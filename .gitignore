# Model outputs, checkpoints and logs are regenerated by the pipeline, never committed.
outputs/
wandb/
*.ckpt
*.safetensors

# data/: the prepared splits and the two OOD pools ARE committed (see data/README.md).
# Everything derived or downloaded beside them is not.
data/*/verl/
data/*/*.jsonl
data/science_raw/

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv-grader/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
